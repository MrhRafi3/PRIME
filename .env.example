# PRIME Local Configuration Overrides (Example)
# Copy to .env (never commit .env) or set environment variables directly.
# PRIME runs 100% locally and requires NO cloud API keys.

# Environment profile: development | production | test
PRIME_ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR
PRIME_LOG_LEVEL=INFO

# Memory profile for Apple Silicon M1 8GB: eco | balanced | heavy
PRIME_MEMORY_PROFILE=balanced

# Primary language priority: bn-en (Bangla + English) | en
PRIME_LANGUAGE_MODE=bn-en

# Optional overrides for local data and log directories (defaults to ~/Library/...)
# PRIME_DATA_DIR=
# PRIME_LOG_DIR=
# PRIME_CONFIG_PATH=

# Privacy safeguards (keep false in normal use)
PRIME_LOG_PRIVATE_CONTENT=false
